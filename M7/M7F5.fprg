<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="M7F5"/>
        <attribute name="authors" value="vedra"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2025-10-20 03:37:00 PM"/>
        <attribute name="created" value="dmVkcmE7U0hJTlk7MjAyNS0xMC0yMDswMzoyMjoyMCBQTTsyMTkw"/>
        <attribute name="edited" value="dmVkcmE7U0hJTlk7MjAyNS0xMC0yMDswMzozNzowMCBQTTsxOzIzMDI="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="answer" type="String" array="False" size=""/>
            <declare name="qty" type="Integer" array="False" size=""/>
            <declare name="price" type="Real" array="False" size=""/>
            <declare name="ext" type="Real" array="False" size=""/>
            <declare name="discprice" type="Real" array="False" size=""/>
            <declare name="discamt" type="Real" array="False" size=""/>
            <declare name="total" type="Real" array="False" size=""/>
            <declare name="sumdisc" type="Real" array="False" size=""/>
            <input variable="answer"/>
            <assign variable="sumdisc" expression="0"/>
            <while expression="answer == &quot;Yes&quot;">
                <input variable="qty"/>
                <input variable="price"/>
                <assign variable="ext" expression="qty * price"/>
                <if expression="ext &gt; 10000">
                    <then>
                        <assign variable="discprice" expression="0.25"/>
                    </then>
                    <else>
                        <assign variable="discprice" expression="0.10"/>
                    </else>
                </if>
                <assign variable="discamt" expression="ext * discprice"/>
                <assign variable="total" expression="ext - discamt"/>
                <output expression="&quot;The price of your items are: $&quot; &amp;ext &amp;&quot; The discount you are recieving is: $&quot; &amp;discamt &amp;&quot; And your total comes to: $&quot; &amp;total" newline="True"/>
                <assign variable="sumdisc" expression="sumdisc + discamt"/>
                <input variable="answer"/>
            </while>
            <output expression="&quot;The total of the discounts you recieved are: $&quot; &amp;sumdisc" newline="True"/>
        </body>
    </function>
</flowgorithm>
