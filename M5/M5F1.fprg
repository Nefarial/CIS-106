<?xml version="1.0"?>
<flowgorithm fileversion="2.11">
    <attributes>
        <attribute name="name" value=""/>
        <attribute name="authors" value="PhotonUser"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2025-09-29 03:54:34 PM"/>
        <attribute name="created" value="UGhvdG9uVXNlcjtFQzJBTUFaLUs0RDA4NjE7MjAyNS0wOS0yOTswMjoxMTo1MiBQTTszMjYx"/>
        <attribute name="edited" value="UGhvdG9uVXNlcjtFQzJBTUFaLUs0RDA4NjE7MjAyNS0wOS0yOTswMzo1NDozNCBQTTszOzMzNzk="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="qty" type="Real" array="False" size=""/>
            <declare name="uprice" type="Real" array="False" size=""/>
            <declare name="extprice" type="Real" array="False" size=""/>
            <declare name="tax" type="Real" array="False" size=""/>
            <declare name="total" type="Real" array="False" size=""/>
            <input variable="qty"/>
            <if expression="qty &gt;= 1000">
                <then>
                    <assign variable="uprice" expression="3.00"/>
                </then>
                <else>
                    <assign variable="uprice" expression="5.00"/>
                </else>
            </if>
            <assign variable="extprice" expression="qty * uprice"/>
            <assign variable="tax" expression="extprice * 0.07"/>
            <assign variable="total" expression="extprice + tax"/>
            <output expression="&quot;Quantity:&quot; &amp;qty" newline="True"/>
            <output expression="&quot;Unit price: $&quot; &amp;uprice" newline="True"/>
            <output expression="&quot;Extended price: $&quot; &amp;extprice" newline="True"/>
            <output expression="&quot;Tax (7%): $&quot; &amp;tax" newline="True"/>
            <output expression="&quot;Total price: $&quot; &amp;total" newline="True"/>
        </body>
    </function>
</flowgorithm>
