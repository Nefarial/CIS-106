<?xml version="1.0"?>
<flowgorithm fileversion="2.11">
    <attributes>
        <attribute name="name" value=""/>
        <attribute name="authors" value="PhotonUser"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2025-09-29 03:55:04 PM"/>
        <attribute name="created" value="UGhvdG9uVXNlcjtFQzJBTUFaLUs0RDA4NjE7MjAyNS0wOS0yOTswMzoyODozMSBQTTszMjY3"/>
        <attribute name="edited" value="UGhvdG9uVXNlcjtFQzJBTUFaLUs0RDA4NjE7MjAyNS0wOS0yOTswMzo1NTowNCBQTTsyOzMzNzY="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="item" type="String" array="False" size=""/>
            <declare name="qty" type="Real" array="False" size=""/>
            <declare name="uprice" type="Real" array="False" size=""/>
            <declare name="extprice" type="Real" array="False" size=""/>
            <input variable="item"/>
            <input variable="qty"/>
            <if expression="item == &quot;A&quot;">
                <then>
                    <assign variable="uprice" expression="10.00"/>
                </then>
                <else>
                    <assign variable="uprice" expression="20.00"/>
                </else>
            </if>
            <assign variable="extprice" expression="qty * uprice"/>
            <output expression="&quot;Item: &quot; &amp;item" newline="True"/>
            <output expression="&quot;Unit price: $&quot; &amp;uprice" newline="True"/>
            <output expression="&quot;Extended price: $&quot; &amp;extprice" newline="True"/>
        </body>
    </function>
</flowgorithm>
