<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="M6F1"/>
        <attribute name="authors" value="vedra"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2025-11-06 05:19:14 PM"/>
        <attribute name="created" value="dmVkcmE7U0hJTlk7MjAyNS0xMS0wNjswNTowOTozNCBQTTsyMjA3"/>
        <attribute name="edited" value="dmVkcmE7U0hJTlk7MjAyNS0xMS0wNjswNToxOToxNCBQTTsxOzIzMTQ="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="qty" type="Integer" array="False" size=""/>
            <declare name="price" type="Real" array="False" size=""/>
            <declare name="ext" type="Real" array="False" size=""/>
            <declare name="tax" type="Real" array="False" size=""/>
            <declare name="total" type="Real" array="False" size=""/>
            <input variable="qty"/>
            <if expression="qty &gt; 10000">
                <then>
                    <assign variable="price" expression="10.00"/>
                </then>
                <else>
                    <if expression="qty &gt;= 5000 AND qty &lt;= 10000">
                        <then>
                            <assign variable="price" expression="20.00"/>
                        </then>
                        <else>
                            <assign variable="price" expression="30.00"/>
                        </else>
                    </if>
                </else>
            </if>
            <assign variable="ext" expression="qty * price"/>
            <assign variable="tax" expression="ext * .07"/>
            <assign variable="total" expression="ext + tax"/>
            <output expression="&quot;Quantity: &quot; &amp;qty" newline="True"/>
            <output expression="&quot;Unit price: $&quot; &amp; price" newline="True"/>
            <output expression="&quot;Extended price: $&quot; &amp; ext" newline="True"/>
            <output expression="&quot;Tax (7%): $&quot; &amp; tax" newline="True"/>
            <output expression="&quot;Total: $&quot; &amp; total" newline="True"/>
        </body>
    </function>
</flowgorithm>
